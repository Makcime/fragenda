<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <style>
      @page {
        size: A4 landscape;
        margin: 1.2cm 2.0cm;
      }

      body {
        font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        color: #1f2933;
        margin: 0;
        font-size: 12px;
      }

      body {
        background: #f8fafc;
      }

      header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        min-height: 72px;
      }

      header h1 {
        font-size: 22px;
        margin: 0;
        letter-spacing: 0.5px;
        text-align: center;
        white-space: nowrap;
        color: #0f172a;
      }

      .brand-logo {
        position: absolute;
        left: 0;
        height: 68px;
        width: auto;
      }

      table.schedule {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
      }

      table.schedule thead th {
        background-color: #dde7f0;
        color: #273447;
        padding: 6px 4px;
        font-weight: 600;
        border: 1px solid #c5d1dc;
        text-align: center;
      }

      table.schedule thead th:first-child {
        text-align: left;
      }

      table.schedule tbody th {
        width: 16%;
        padding: 6px 4px;
        text-align: left;
        border: 1px solid #d1d9e0;
        background-color: #eef3f7;
        font-weight: 600;
      }

      table.schedule tbody td {
        border: 1px solid #e0e7ef;
        padding: 0;
        vertical-align: top;
        min-height: 72px;
      }

      table.schedule tbody td.empty {
        background-color: #f7f9fc;
        color: #9aa5b1;
        text-align: center;
        font-style: italic;
        padding: 8px 6px;
      }

      .slot-label {
        display: block;
        font-size: 11px;
        color: #52606d;
      }

      .slot-interval {
        display: block;
        font-size: 12px;
      }

      .cell-entries {
        display: grid;
        gap: 6px;
        padding: 6px 6px 8px;
      }

      .cell-entries.layout-single {
        grid-template-columns: 1fr;
      }

      .cell-entries.layout-stack {
        grid-template-columns: 1fr;
      }

      .cell-entries.layout-week-split {
        display: flex;
        gap: 6px;
        align-items: stretch;
      }

      .week-column {
        display: flex;
        flex: 1 1 0;
        flex-direction: column;
        gap: 6px;
      }

      .week-column.week-a {
        order: 1;
      }

      .week-column.week-b {
        order: 2;
      }

      .week-column.week-ab {
        flex: 1 1 100%;
        order: 3;
      }

      .entry {
        border-left: 3px solid #3f83f8;
        padding: 4px 6px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-height: 60px;
        hyphens: auto;
        overflow-wrap: break-word;
      }

      .entry.week-a:not(.option) {
        border-color: #2563eb;
        background: #eff6ff;
      }

      .entry.week-b:not(.option) {
        border-color: #ec4899;
        background: #fdf2f8;
      }

      .entry.shared {
        border-color: #0e9f6e;
      }

      .entry.week-ab:not(.option) {
        border-color: #0e9f6e;
        background: #ecfdf5;
      }

      .entry.option {
        border-color: #fb923c;
        background: #fff7ed;
      }

      .entry .week {
        font-weight: 600;
        font-size: 11px;
        color: #0c4a6e;
        letter-spacing: 0.3px;
      }

      .entry .course {
        display: block;
        font-weight: 600;
        font-size: 12px;
        margin-top: 1px;
      }

      .entry .meta {
        display: block;
        font-size: 11px;
        color: #52606d;
      }

      .entry .detail {
        display: block;
        font-size: 10.5px;
        color: #616e7c;
        margin-top: 1px;
      }

      .entry .code {
        display: block;
        font-size: 10px;
        color: #7b8794;
        margin-top: auto;
      }

      @media screen {
        body {
          background: #ffffff;
          padding: 32px;
        }

        table.schedule {
          margin: 0 auto;
          box-shadow: none;
          border-radius: 12px;
        }

        header {
          margin-bottom: 24px;
        }
      }

      footer {
        margin-top: 18px;
        text-align: right;
        font-size: 10px;
        color: #7b8794;
      }
    </style>

    {% macro render_entry(entry, scope) -%}
      <div class="entry {{ 'shared' if entry.is_shared }} week-{{ entry.week|lower }}{% if scope == 'classe' and entry.is_option %} option{% endif %}">
        {% if entry.week != 'AB' %}
          <span class="week">{{ entry.week }}</span>
        {% endif %}
        <span class="course">{{ entry.course }}</span>
        {% set class_list = entry.class_display %}
        {% set teacher_list = entry.teacher_display %}
        {% set room_value = entry.room_display %}
        {% if scope == 'pro' %}
          {% if class_list %}
            <span class="meta">{{ class_list }}</span>
          {% endif %}
          {% if entry.has_room and room_value and room_value != '—' %}
            <span class="detail">{{ room_value }}</span>
          {% endif %}
        {% elif scope == 'classe' %}
          {% if entry.has_teachers %}
            <span class="meta">{{ teacher_list }}</span>
          {% endif %}
          {% if entry.has_room and room_value and room_value != '—' %}
            <span class="detail">{{ room_value }}</span>
          {% endif %}
        {% else %}
          {% if class_list %}
            <span class="meta">{{ class_list }}</span>
          {% endif %}
          {% if entry.has_teachers %}
            <span class="detail">{{ teacher_list }}</span>
          {% endif %}
          {% if entry.has_room and room_value and room_value != '—' and not class_list and not entry.has_teachers %}
            <span class="meta">{{ room_value }}</span>
          {% endif %}
        {% endif %}
        {% if entry.has_codes %}
          <span class="code">{{ entry.code_display }}</span>
        {% endif %}
      </div>
    {%- endmacro %}
  </head>
  <body>
    <header>
      <img src="{{ logo_src }}" alt="Logo de l'école" class="brand-logo" />
      <h1>{{ title }}</h1>
    </header>

    <table class="schedule">
      <thead>
        <tr>
          <th>Plage</th>
          {% for label in day_labels %}
            <th>{{ label }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in slot_rows %}
          <tr>
            <th>
              <span class="slot-label">{{ row.label }}</span>
              <span class="slot-interval">{{ row.interval }}</span>
            </th>
            {% for cell in row.cells %}
              {% set cell_class = 'layout-' ~ cell.layout %}
              <td class="{{ 'empty' if cell.is_empty }}">
                {% if cell.is_empty %}
                  &mdash;
                {% else %}
                  {% if cell.layout == 'week-split' %}
                    {% set week_a = cell.entries | selectattr('week', 'equalto', 'A') | list %}
                    {% set week_b = cell.entries | selectattr('week', 'equalto', 'B') | list %}
                    {% set week_ab = cell.entries | selectattr('week', 'equalto', 'AB') | list %}
                    <div class="cell-entries layout-week-split">
                      <div class="week-column week-a">
                        {% for entry in week_a %}
                          {{ render_entry(entry, scope) }}
                        {% endfor %}
                      </div>
                      <div class="week-column week-b">
                        {% for entry in week_b %}
                          {{ render_entry(entry, scope) }}
                        {% endfor %}
                      </div>
                      {% for entry in week_ab %}
                        <div class="week-column week-ab">
                          {{ render_entry(entry, scope) }}
                        </div>
                      {% endfor %}
                    </div>
                  {% else %}
                    <div class="cell-entries {{ cell_class }}">
                      {% for entry in cell.entries %}
                        {{ render_entry(entry, scope) }}
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endif %}
              </td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <footer>{{ build_str }}</footer>
  </body>
</html>
